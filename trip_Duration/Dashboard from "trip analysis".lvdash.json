{
  "datasets": [
    {
      "name": "6691bf4a",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `nyc_trip_workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    CAST(tpep_pickup_datetime AS DATE) AS pickup_date,\n",
        "    COUNT(VendorID) AS total_trips,\n",
        "    SUM(passenger_count) AS total_passengers_carried,\n",
        "    ROUND(SUM(trip_distance), 2) AS total_distance_miles,\n",
        "    ROUND(SUM(fare_amount), 2) AS total_fare_revenue_usd,\n",
        "    ROUND(SUM(tip_amount), 2) AS total_tips_collected_usd,\n",
        "    ROUND(SUM(total_amount), 2) AS total_gross_revenue_usd,\n",
        "    ROUND(AVG(trip_duration_minutes), 2) AS avg_trip_duration_minutes,\n",
        "    -- Safe division for tip percentage\n",
        "    ROUND(\n",
        "        COALESCE(SUM(tip_amount) / NULLIF(SUM(fare_amount), 0) * 100, 0), 2\n",
        "    ) AS avg_tip_percentage\n",
        "FROM dev_nyc.silver.taxi_duartion -- Replace with your actual silver table name\n",
        "GROUP BY CAST(tpep_pickup_datetime AS DATE)\n",
        "ORDER BY pickup_date DESC;\n"
      ]
    },
    {
      "name": "e9f00dde",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `nyc_trip_workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "-- Widget: Hourly Traffic Volume Profile\n",
        "SELECT \n",
        "    pickup_hour,\n",
        "    ROUND(AVG(trip_demand_volume), 0) AS average_trips_per_hour\n",
        "FROM \n",
        "    dev_nyc.gold.fact_hourly_demand\n",
        "GROUP BY \n",
        "    pickup_hour\n",
        "ORDER BY \n",
        "    pickup_hour ASC;\n"
      ]
    },
    {
      "name": "b62c6979",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `nyc_trip_workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "-- Widget: Speed Decay vs Revenue Impact\n",
        "SELECT \n",
        "    avg_speed_mph,\n",
        "    avg_base_fare,\n",
        "    trip_demand_volume\n",
        "FROM \n",
        "    dev_nyc.gold.fact_hourly_demand\n",
        "WHERE \n",
        "    avg_speed_mph > 0 AND avg_speed_mph < 60 -- Data Cleaning Bounds\n",
        "ORDER BY \n",
        "    trip_demand_volume DESC;\n"
      ]
    },
    {
      "name": "8cbd654a",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `nyc_trip_workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    CONCAT('Zone ', PULocationID, ' ➡️ Zone ', DOLocationID) AS transit_corridor,\n",
        "    VendorID,\n",
        "    SUM(trip_count) AS trip_count,\n",
        "    ROUND(SUM(total_revenue), 2) AS corridor_revenue_usd,\n",
        "    ROUND(SUM(total_distance_miles) / NULLIF(SUM(total_duration_minutes) / 60.0, 0), 2) AS corridor_avg_speed_mph\n",
        "FROM \n",
        "    dev_nyc.gold.fact_vendor_performance\n",
        "GROUP BY \n",
        "    PULocationID, DOLocationID, VendorID\n",
        "ORDER BY \n",
        "    corridor_revenue_usd DESC\n",
        "LIMIT 10;\n"
      ]
    },
    {
      "name": "53f376a7",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `nyc_trip_workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    pickup_hour,\n",
        "    VendorID,\n",
        "    SUM(total_revenue) AS hourly_gross_revenue,\n",
        "    SUM(trip_count) AS hourly_trip_volume\n",
        "FROM \n",
        "    dev_nyc.gold.fact_vendor_performance\n",
        "GROUP BY \n",
        "    pickup_hour, VendorID\n",
        "ORDER BY \n",
        "    pickup_hour ASC;\n"
      ]
    },
    {
      "name": "76784dc0",
      "displayName": "Untitled dataset",
      "queryLines": [
